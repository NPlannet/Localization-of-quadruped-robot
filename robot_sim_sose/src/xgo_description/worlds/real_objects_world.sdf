          <material><ambient>0.09 0.11 0.13 1</ambient><diffuse>0.09 0.11 0.13 1</diffuse></material>
        </visual>
        <visual name="base">
          <pose>0 0 -0.55 0 0 0</pose>
          <geometry><cylinder><radius>0.30</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
        <visual name="post">
          <pose>0 0 -0.35 0 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>0.45</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="walking_person">
      <pose>-2.8 -2.0 0.45 0 0 0</pose>
      <link name="body">
        <gravity>false</gravity>
        <inertial>
          <mass>3.0</mass>
          <inertia>
            <ixx>0.16666</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.16666</iyy>
            <iyz>0</iyz>
            <izz>0.16666</izz>
