        </inertial>
        <velocity_decay>
          <linear>0.5</linear>
          <angular>2.0</angular>
        </velocity_decay>
        <collision name="lidar_collision">
          <geometry><box><size>0.55 0.55 0.90</size></box></geometry>
          <surface>
            <friction>
              <bullet>
                <friction>0.7</friction>
