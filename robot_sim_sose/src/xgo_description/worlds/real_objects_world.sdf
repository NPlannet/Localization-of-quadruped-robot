    <model name="moving_chair">
      <pose>1.2 -1.7 0.45 0 0 -1.5708</pose>
      <link name="body">
        <gravity>false</gravity>
        <inertial>
          <mass>1.5</mass>
          <inertia>
            <ixx>0.12</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.12</iyy>
            <iyz>0</iyz>
            <izz>0.08</izz>
          </inertia>
        </inertial>
        <velocity_decay>
          <linear>0.5</linear>
          <angular>0.8</angular>
        </velocity_decay>
        <collision name="lidar_collision">
          <geometry><box><size>0.70 0.70 0.90</size></box></geometry>
          <surface>
            <friction>
              <bullet>
                <friction>0.7</friction>
                <friction2>1.0</friction2>
                <rolling_friction>0.2</rolling_friction>
              </bullet>
            </friction>
          </surface>
        </collision>
        <visual name="seat">
          <pose>0 0 -0.18 0 0 0</pose>
          <geometry><box><size>0.65 0.65 0.10</size></box></geometry>
          <material><ambient>0.18 0.22 0.25 1</ambient><diffuse>0.18 0.22 0.25 1</diffuse></material>
        </visual>
        <visual name="back">
          <pose>-0.28 0 0.18 0 0 0</pose>
          <geometry><box><size>0.10 0.65 0.70</size></box></geometry>
          <material><ambient>0.13 0.16 0.18 1</ambient><diffuse>0.13 0.16 0.18 1</diffuse></material>
        </visual>
        <visual name="front_left_leg">
          <pose>0.22 0.22 -0.48 0 0 0</pose>
          <geometry><box><size>0.07 0.07 0.55</size></box></geometry>
          <material><ambient>0.07 0.07 0.07 1</ambient><diffuse>0.07 0.07 0.07 1</diffuse></material>
        </visual>
        <visual name="front_right_leg">
          <pose>0.22 -0.22 -0.48 0 0 0</pose>
          <geometry><box><size>0.07 0.07 0.55</size></box></geometry>
          <material><ambient>0.07 0.07 0.07 1</ambient><diffuse>0.07 0.07 0.07 1</diffuse></material>
        </visual>
        <visual name="rear_left_leg">
          <pose>-0.22 0.22 -0.48 0 0 0</pose>
          <geometry><box><size>0.07 0.07 0.55</size></box></geometry>
          <material><ambient>0.07 0.07 0.07 1</ambient><diffuse>0.07 0.07 0.07 1</diffuse></material>
        </visual>
        <visual name="rear_right_leg">
          <pose>-0.22 -0.22 -0.48 0 0 0</pose>
          <geometry><box><size>0.07 0.07 0.55</size></box></geometry>
          <material><ambient>0.07 0.07 0.07 1</ambient><diffuse>0.07 0.07 0.07 1</diffuse></material>
        </visual>
      </link>
    </model>


    <model name="office_chair">
      <static>true</static>
      <pose>2.4 1.4 0.50 0 0 -0.4</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.75 0.75 1.0</size></box></geometry>
        </collision>
        <visual name="seat">
          <pose>0 0 -0.22 0 0 0</pose>
          <geometry><box><size>0.70 0.70 0.12</size></box></geometry>
          <material><ambient>0.12 0.14 0.16 1</ambient><diffuse>0.12 0.14 0.16 1</diffuse></material>
        </visual>
        <visual name="back">
          <pose>-0.30 0 0.18 0 0 0</pose>
